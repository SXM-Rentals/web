# SXM Rentals — Created by Giordano Bertin-Maurice
# Copyright (c) 2026 Giordano Bertin-Maurice. All rights reserved.
# WHAT THIS FILE DOES: Lists every setting the website needs, with an
# explanation of each. Copy it to ".env.local" and fill in the values — that
# copy is ignored by git and never leaves your computer.
#
# NOTHING SECRET BELONGS IN THIS FILE. It is committed, so anything written
# here is public. It exists to say which settings exist, not what they are.


# ---- WHERE THE BACKEND IS ----
#
# The API the website reads from. No trailing slash, and no "/api/v1" on the
# end — that part is added where the request is made.
#
# WHY THERE IS NO "NEXT_PUBLIC_" ON THE FRONT, which is the important bit: a
# setting named NEXT_PUBLIC_* is compiled into the JavaScript the browser
# downloads, where anybody can read it. This one is deliberately server-only,
# so the API's real address never reaches the browser at all.
#
# That is not about hiding it. It is what forces every request from a browser
# to go through this website's own address instead (see the rewrite in
# next.config.mjs) — which is the only way the sign-in cookie works, because a
# browser will not send a cookie from one website to a different one.
#
#   Live:            https://sxm-rentals-api.onrender.com
#   Backend locally: http://localhost:3000
#
# RUNNING THE BACKEND ON YOUR OWN COMPUTER? It also defaults to port 3000, the
# same as this website. Start the website on another port instead:
#
#   npm run dev -- -p 3001
#
API_URL=https://sxm-rentals-api.onrender.com


# ---- WHERE THE WEBSITE ITSELF LIVES ----
#
# Used to build the full web addresses a search engine needs — the sitemap,
# the canonical link on every page, and the preview card shown when somebody
# pastes a link into a message.
#
# This one IS public, and has to be: the browser needs it too.
#
#   Deployed:  https://www.sxmrentals.app
#              (with the www — the bare sxmrentals.app redirects to it. And
#              not the .vercel.app address, which keeps working but is not
#              the one search engines should credit. See lib/seo.ts.)
#   Locally:   http://localhost:3001   (3000 if the backend is not running)
#
# SET THIS IN THE HOSTING SETTINGS, not just here. This file is an example and
# is never read by the deployed site — Vercel takes its settings from its own
# environment variables, so a value written here does not reach production.
#
# If it is missing there anyway, lib/seo.ts falls back to the deployed address
# rather than to localhost, so a forgotten setting cannot publish a sitemap
# full of localhost links. That is a safety net and not a substitute: the
# fallback is a line of code that has to be edited when the domain changes,
# and this variable is not.
#
NEXT_PUBLIC_SITE_URL=http://localhost:3001


# ---- REAL CARS, OR THE SAMPLE ONES ----
#
# "true"  — the catalogue comes from the API
# "false" — the catalogue comes from the sample data in lib/mock/
#
# This exists because the live database is currently empty, so switching the
# catalogue over makes the site look broken rather than new. It is a temporary
# setting and should be deleted once there are real cars to show.
#
# Signing in, bookings and messages ignore this — there is no sample data
# worth keeping for those, so they always use the API.
#
NEXT_PUBLIC_LIVE_CATALOGUE=false
